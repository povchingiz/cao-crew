#!/usr/bin/env bash
#
# cao-update — one command to keep cao-crew current.
#
# Pulls the latest repo code, refreshes worker CLIs, re-applies the
# site-packages patches that `cao update` silently erases, refreshes the
# ~/.local/bin symlinks, re-renders configs, and re-runs the doctor check.
#
#   cao-update            git sync + patches + symlinks + apply + doctor
#   cao-update --npm      only update worker CLIs via npm
#   cao-update --full     git sync + npm CLIs + patches + apply + doctor
#   cao-update -y         auto-confirm every prompt (non-interactive)
#   cao-update -h         show this help
#
# Safe to re-run at any time — every step is idempotent.
set -euo pipefail

# Resolve our own real location (through any ~/.local/bin symlink chain),
# matching cao-doctor / cao-patch so the repo is found wherever it lives.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  T="$(readlink "$SELF")"; case "$T" in /*) SELF="$T" ;; *) SELF="$(dirname "$SELF")/$T" ;; esac
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"

log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m[ok]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*"; }

usage() {
  awk 'NR>1{ if(/^#/){sub(/^# ?/,"");print} else if(NF){exit} }' "$0"
}

FULL=0
NPM_ONLY=0
ASSUME_YES=0
while [ $# -gt 0 ]; do
  case "$1" in
    --full)   FULL=1 ;;
    --npm)    NPM_ONLY=1 ;;
    -y|--yes) ASSUME_YES=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown flag: $1. Run cao-update --help" >&2; exit 1 ;;
  esac
  shift
done

# ---------------------------------------------------------------------------
# 1. Git sync (skipped for --npm)
# ---------------------------------------------------------------------------
if [ "$NPM_ONLY" = 0 ]; then
  if [ ! -d "$REPO/.git" ]; then
    warn "not a git checkout — skipping code sync"
  else
    if [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]; then
      warn "working tree has local changes — skipping git pull to protect your work"
      warn "commit or stash them, then re-run cao-update for the latest code"
      if [ "$ASSUME_YES" = 1 ]; then
        log "continuing with local changes (-y): patches/apply still refresh against this checkout"
      else
        printf "Continue with the local checkout anyway? [y/N] "
        if [ ! -t 0 ]; then
          ans="N"
        else
          read -r ans || ans="N"
        fi
        case "${ans:-N}" in
          y|Y) log "continuing with local changes" ;;
          *)   echo "Aborted."; exit 1 ;;
        esac
      fi
    else
      log "Pulling latest code (git pull --ff-only)..."
      if git -C "$REPO" pull --ff-only; then
        ok "repo up to date"
      else
        warn "git pull --ff-only failed (diverged/offline?) — continuing with current code"
      fi
    fi
  fi
fi

# ---------------------------------------------------------------------------
# 2. Worker CLIs via npm (--full or --npm)
# ---------------------------------------------------------------------------
if [ "$FULL" = 1 ] || [ "$NPM_ONLY" = 1 ]; then
  if ! command -v npm >/dev/null 2>&1; then
    warn "npm not found — skipping worker CLI updates"
  else
    log "Updating worker CLIs via npm..."
    npm i -g @anthropic-ai/claude-code@latest @openai/codex@latest opencode-ai@latest || true
    ok "worker CLIs updated"
  fi
fi

# npm-only mode stops here.
[ "$NPM_ONLY" = 1 ] && { ok "npm update complete."; exit 0; }

# ---------------------------------------------------------------------------
# 3. Site-packages patches (the ones 'cao update' erases)
# ---------------------------------------------------------------------------
log "Re-applying CAO site-packages patches..."
"$REPO/run/cao-patch"

# ---------------------------------------------------------------------------
# 4. Refresh ~/.local/bin symlinks (same list as bootstrap.sh)
# ---------------------------------------------------------------------------
log "Refreshing ~/.local/bin symlinks..."
mkdir -p "$HOME/.local/bin"
for tool in cao-run cao-doctor cao-patch cao-stop cao-tokens cao-plugins cao-limits cao-monitor cao-aggressive cao-auto cao-plan cao-memory cao-config cao-update; do
  if [ -f "$REPO/run/$tool" ]; then
    ln -sfn "$REPO/run/$tool" "$HOME/.local/bin/$tool"
    chmod +x "$REPO/run/$tool"
  fi
done
ok "symlinks refreshed in ~/.local/bin"

# ---------------------------------------------------------------------------
# 5. Re-render configs + re-register worker profiles
# ---------------------------------------------------------------------------
log "Re-compiling configs and re-registering worker profiles..."
"$REPO/setup/3_apply/apply.sh" -y

# ---------------------------------------------------------------------------
# 6. Pre-flight doctor check
# ---------------------------------------------------------------------------
log "Running pre-flight doctor check..."
"$REPO/run/cao-doctor" || warn "doctor flagged issues above — review before launching"

echo
echo '============================================================'
echo '🚀 cao-crew updated, patched, and ready to fly!'
echo '============================================================'
